/*
 * Nextflow Configuration File
 * PacBio HiFi Vector Alignment Pipeline
 */

// Default parameters
params {
    // Input/Output
    samplesheet = null
    vector_fasta = null
    genome_fasta = null
    outdir = 'results'
    
    // Resource defaults
    max_cpus = 16
    max_memory = '64.GB'
    max_time = '24.h'
}

// Process configuration
process {
    // Default container for most processes
    container = 'bumproo/general_genomics'
    
    // Default resources
    cpus = 4
    memory = '8.GB'
    time = '4.h'
    
    // Process-specific resources and containers
    withName: 'NANOPLOT_QC' {
        container = 'bumproo/nanoplotchopper'
        cpus = 4
        memory = '8.GB'
        time = '2.h'
    }
    
    withName: 'ALIGN_TO_VECTOR' {
        cpus = 8
        memory = '16.GB'
        time = '4.h'
    }
    
    withName: 'EXTRACT_VECTOR_HITS' {
        cpus = 2
        memory = '8.GB'
        time = '2.h'
    }
    withName: 'ALIGN_ORIGINAL_TO_GENOME' {
    cpus = 8
    memory = '32.GB'    // ← Increased from default 8GB
    time = '8.h'
    }
    
    withName: 'ALIGN_TO_GENOME' {
        cpus = 8
        memory = '32.GB'
        time = '6.h'
    }
}

// Docker configuration
docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Singularity configuration (alternative to Docker)
singularity {
    enabled = false
    autoMounts = true
}

// Execution profiles
profiles {
    docker {
        docker.enabled = true
        singularity.enabled = false
    }
    
    singularity {
        singularity.enabled = true
        docker.enabled = false
    }
    
    local {
        process.executor = 'local'
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
    }
}

// Report configuration
report {
    enabled = true
    file = "${params.outdir}/execution_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/execution_timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/execution_trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_dag.html"
}

// Manifest
manifest {
    name = 'PacBio HiFi Vector Alignment Pipeline'
    author = 'Seqera AI'
    description = 'Pipeline for processing PacBio HiFi reads with vector alignment and genome mapping'
    version = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
